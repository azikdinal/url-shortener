# REST API
HTTP_URL=0.0.0.0:8000 # !Порт проброшен в docker image и docker-compose.yml
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=5s

# GRPC
# !порт 8001 проброшен в docker image и docker-compose.yml
GRPC_URL=0.0.0.0:8001

# название хоста, которое будет добавляться к коду
PUBLIC_HOST=https://shorty.io/

# способ хранения данных: "POSTGRES" или "IN_MEMORY"
STORE_TYPE=POSTGRES

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DBNAME=shorten
PG_SSL_MODE=disable

PG_MAX_OPEN_CONN=20
PG_MAX_IDLE_CONN=10
PG_CONN_MAX_LIFETIME=5m
